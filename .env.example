# =============================================================================
# .env.example — Whallet / cnabportal
#
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env — ele já está no .gitignore.
# =============================================================================

# -- PostgreSQL ---------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cnabportal
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua_senha_aqui

# -- JWT ----------------------------------------------------------------------
# Gere um secret forte: openssl rand -base64 64
JWT_SECRET=seu_jwt_secret_aqui
JWT_EXPIRATION_MS=28800000

# -- Resend (emails transacionais) --------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@whallet.com.br

# -- Stripe -------------------------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_WHALLET_PLUS=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -- OpenAI -------------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -- Google OAuth -------------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# -- WhatsApp (Evolution API) -------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_evolution_aqui
EVOLUTION_INSTANCE=whallet

# -- URLs da aplicação --------------------------------------------------------
APP_URL=http://localhost:5173
