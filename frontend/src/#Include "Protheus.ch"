#Include "Protheus.ch"

/*/{Protheus.doc} MT140PC
    Libera a Pré-Nota sem Pedido de Compra quando o CFOP for 6920.
    Nos demais casos, respeita o valor padrão do parâmetro MV_PCNFE.

    Retorno:
        .T. = obriga pedido de compra
        .F. = não obriga pedido de compra
/*/
User Function MT140PC()

    Local lRet  := ParamIXB[1]
    Local cCFOP := ""

    // Tenta obter o CFOP corrente do item da pré-nota
    If Type("M->D1_CF") <> "U"
        cCFOP := AllTrim(M->D1_CF)
    EndIf

    // Regra: CFOP 6920 não exige pedido de compra
    If cCFOP == "6920"
        lRet := .F.
    EndIf

Return lRet